# Application Settings
PROJECT_NAME="Personalized AI Health Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Server Configuration
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="health_assistant_db"
DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/health_assistant_db"

# Security & Authentication
JWT_SECRET_KEY="replace-this-with-a-very-secure-random-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI / LLM Configuration
LLM_PROVIDER="openai" # e.g., openai, gemini, or anthropic
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="gpt-4o-mini"

# Map / Healthcare Location Provider
MAP_API_KEY="your-map-service-key"
