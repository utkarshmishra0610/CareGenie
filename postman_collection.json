                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@example.com\",\n  \"username\": \"patient_john\",\n  \"password\": \"StrongPassword123!\",\n  \"full_name\": \"John Doe\",\n  \"preferred_language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
